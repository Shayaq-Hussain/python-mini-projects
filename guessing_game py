import random

secret = random.randint(1, 100)
attempts = 0

print("=== NUMBER GUESSING GAME ===")
print("Guess a number between 1 and 100!")

while True:
    guess = int(input("Your guess: "))
    attempts += 1

    if guess < secret:
        print("Too low! Try again.")
    elif guess > secret:
        print("Too high! Try again.")
    else:
        print("🎉 Correct!")
        print("Attempts:", attempts)
        break